[{"id":113,"time":"2025-11-14T16:11:13Z","channel":"STABLE","commits":[{"sha":"9fc21bcbf252eec5a6704209b336dcc41330dd33","time":"2025-11-14T16:09:50Z","message":"Promote build channel from BETA to STABLE\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-113.jar","checksums":{"sha256":"d4f897545310f31e623d9680786b25dd20a9989e139db050d1aacf81ecafd05c"},"size":54474189,"url":"https://fill-data.papermc.io/v1/objects/d4f897545310f31e623d9680786b25dd20a9989e139db050d1aacf81ecafd05c/paper-1.21.10-113.jar"}}},{"id":112,"time":"2025-11-14T01:41:07Z","channel":"BETA","commits":[{"sha":"f393100d5d85cf74b48e0d55a55fe79c13486957","time":"2025-11-14T01:40:07Z","message":"Update ConcurrentUtil to 0.0.7\n"},{"sha":"0e10753e46a96a4861ff33cdf5103a31ab091557","time":"2025-11-14T01:04:23Z","message":"Update ConcurrentUtil to 0.0.6\n\nFixes https://github.com/PaperMC/Paper/issues/13275\n\nSee\n- https://github.com/Tuinity/ConcurrentUtil/releases/tag/v0.0.6\n- https://github.com/Tuinity/ConcurrentUtil/commit/42e72d7efdc33cbadc6f07a2e93fb276bb5b6328\n"},{"sha":"d16e03fbaa08ca316ef35384f6a6077cde0eafe5","time":"2025-11-12T17:01:48Z","message":"[ci skip] Add IntelliJ tips to CONTRIBUTING.md (#13299)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-112.jar","checksums":{"sha256":"d901c205cebd2c14e2d92c5fcbd0ba95add71da9726fc7829d1431a8b80969b6"},"size":54472996,"url":"https://fill-data.papermc.io/v1/objects/d901c205cebd2c14e2d92c5fcbd0ba95add71da9726fc7829d1431a8b80969b6/paper-1.21.10-112.jar"}}},{"id":108,"time":"2025-11-10T18:27:52Z","channel":"BETA","commits":[{"sha":"97452e19d92621ba28844fa2cf9ab59c6eadcfe7","time":"2025-11-10T18:27:10Z","message":"Improvements for Player#openBook (#12582)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-108.jar","checksums":{"sha256":"2c825ddbe47897db1efbf1adfef0dbcfee7ebab2f959168cf59a654f3bdd0b36"},"size":54461166,"url":"https://fill-data.papermc.io/v1/objects/2c825ddbe47897db1efbf1adfef0dbcfee7ebab2f959168cf59a654f3bdd0b36/paper-1.21.10-108.jar"}}},{"id":107,"time":"2025-11-10T18:01:27Z","channel":"BETA","commits":[{"sha":"cf02a0719a15597b9cb4690d7a142109dc01ad99","time":"2025-11-10T18:00:08Z","message":"Add Particle.Spell support to ParticleBuilder#color(Color, float) (#13128)\n\n"},{"sha":"1d2d956629254dfed26197e294931f109a292b39","time":"2025-11-10T17:55:43Z","message":"fix(#13144): Entity pathfinding paths do not appear with 1.21.9 debug flag enabled (#13202)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-107.jar","checksums":{"sha256":"3274b2eb51bffa2468ac46c21b063a7c18ed35965a1c7f072ae3b95f3e70e432"},"size":54460964,"url":"https://fill-data.papermc.io/v1/objects/3274b2eb51bffa2468ac46c21b063a7c18ed35965a1c7f072ae3b95f3e70e432/paper-1.21.10-107.jar"}}},{"id":105,"time":"2025-11-04T19:32:20Z","channel":"BETA","commits":[{"sha":"1f31ee5ebe45d97a596a4429d9871e3f8910cd28","time":"2025-11-04T19:07:54Z","message":"Do not record task execution time as TickTime individually\n\nThe number of recorded instances may be high and subsequently\ncause calculations of MSPT or TPS to be abnormally high.\n\nInstead, we record task execution time as a sum on TickTime itself.\nTask execution time is tracked for the next tick.\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-105.jar","checksums":{"sha256":"c4fdb280847a142761a4e3251a4c8be4342c7139f4d91e042960a48463a4b5fd"},"size":54462425,"url":"https://fill-data.papermc.io/v1/objects/c4fdb280847a142761a4e3251a4c8be4342c7139f4d91e042960a48463a4b5fd/paper-1.21.10-105.jar"}}},{"id":104,"time":"2025-11-04T19:08:24Z","channel":"BETA","commits":[{"sha":"a41043f2e63eb0b7f2375136493a83f4e5144aeb","time":"2025-11-04T18:07:38Z","message":"Add back command source for command blocks with output disabled and fix bukkit->minecraft not respecting output disabled for minecart command blocks (#13271)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-104.jar","checksums":{"sha256":"0a1cf5ed22d69fae2edaf263f76d44d968288328ad97a48385f6fd1336ebc031"},"size":54465134,"url":"https://fill-data.papermc.io/v1/objects/0a1cf5ed22d69fae2edaf263f76d44d968288328ad97a48385f6fd1336ebc031/paper-1.21.10-104.jar"}}},{"id":101,"time":"2025-11-04T15:57:31Z","channel":"BETA","commits":[{"sha":"893ea746a011c944a27ce261a33b66c0fddad970","time":"2025-11-04T15:55:16Z","message":"Make stage 2 chunk unload utilise I/O future write\n\nWhen the I/O scheduler was rewritten, it was designed to\ntake writes as futures (i.e. CallbackCompletable, Completable).\nWe can utilise this functionality in entity and chunk unloading.\n\nProvided that the write is scheduled during stage 3, we can remove\nthe unload tasks - even if the write value is not yet ready.\n\nFor entity chunk unloading, when the entity chunk is transient it needs\nto load the current data on-disk to save. We can create a write future\nwhich depends on the result from loading the current data from disk.\nThe previous behavior was to perform a blocking read on the chunk data,\nas the previous behavior was designed with an I/O scheduler which\ncould not perform future writes.\n\nFor chunk unloading, the logic already issues a future value write.\nThe only changes made are to forward exceptions to the I/O thread\nand to move the unload task completion to the stage 2 function\nitself (which additionally avoids a double write schedule).\n\nWith these changes, all of chunk, entity, and poi tasks issue\nan I/O write during unload (unless there is nothing to write). This\nallows for all of the unload tasks to be removed during stage 3.\n\nAdditionally, make the I/O scheduler properly handle exceptions from\nfuture writes - print the exception and avoid the write. Previously,\nthe behavior was to not print an exception and to delete the data\nfrom disk.\n\nThe main benefit from these changes is that transient entity chunk\nunloads no longer issue a blocking read from disk.\n\nhttps://github.com/Tuinity/Moonrise/pull/144\nhttps://github.com/Tuinity/Moonrise/pull/146\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-101.jar","checksums":{"sha256":"2051cc7584f86bbaee42930473394fb9c2f81129b4b25ce488e8afbc83693509"},"size":54464555,"url":"https://fill-data.papermc.io/v1/objects/2051cc7584f86bbaee42930473394fb9c2f81129b4b25ce488e8afbc83693509/paper-1.21.10-101.jar"}}},{"id":100,"time":"2025-11-01T22:04:43Z","channel":"BETA","commits":[{"sha":"e8c6ba5068287049c890688534963041208c4213","time":"2025-11-01T22:04:02Z","message":"Expose JukeboxSong variables (#13214)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-100.jar","checksums":{"sha256":"afdb17c6e33f667d9c3c1dd68c982990a5f9cfd60a0c85b6c07dcfe4fc6a0b02"},"size":54460099,"url":"https://fill-data.papermc.io/v1/objects/afdb17c6e33f667d9c3c1dd68c982990a5f9cfd60a0c85b6c07dcfe4fc6a0b02/paper-1.21.10-100.jar"}}},{"id":99,"time":"2025-11-01T21:57:22Z","channel":"BETA","commits":[{"sha":"5fd3c951d4feae3c38da77aab6fd10fd5151f5f2","time":"2025-11-01T21:56:04Z","message":"Add Entity#teleportAsync(Location, TeleportFlag...) (#13208)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-99.jar","checksums":{"sha256":"a282b061d17dc7feb3fc32b6975a3f5ff928cb5ee1d3da85afd0b8710ec06a2e"},"size":54459866,"url":"https://fill-data.papermc.io/v1/objects/a282b061d17dc7feb3fc32b6975a3f5ff928cb5ee1d3da85afd0b8710ec06a2e/paper-1.21.10-99.jar"}}},{"id":98,"time":"2025-11-01T21:54:40Z","channel":"BETA","commits":[{"sha":"fcb2956ae67bbac328b6904d62e8fc4d387f3840","time":"2025-11-01T21:53:22Z","message":"Add debug logging for entities with invalid ids (#13229)\n\n"},{"sha":"e74d70233de896ca00fcffada4ab68b3b1cc4b71","time":"2025-11-01T21:50:47Z","message":"Fix HelpMap topic creation for bootstrap commands (#13231)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-98.jar","checksums":{"sha256":"07a673928cbbbb652041a934414dccf5a721bbf7c66ee27d477f1b605258f8b0"},"size":54461352,"url":"https://fill-data.papermc.io/v1/objects/07a673928cbbbb652041a934414dccf5a721bbf7c66ee27d477f1b605258f8b0