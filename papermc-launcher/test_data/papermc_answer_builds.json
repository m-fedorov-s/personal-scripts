loads":{"server:default":{"name":"paper-1.21.10-92.jar","checksums":{"sha256":"1f6ba7a45d0afb318f038fb11cdf34d2e0911257b16640c23a3ffdc16fb902da"},"size":54463170,"url":"https://fill-data.papermc.io/v1/objects/1f6ba7a45d0afb318f038fb11cdf34d2e0911257b16640c23a3ffdc16fb902da/paper-1.21.10-92.jar"}}},{"id":91,"time":"2025-10-27T18:27:20Z","channel":"BETA","commits":[{"sha":"9934c17322980f2f67e2a47d09b08fb8a8a881c6","time":"2025-10-27T17:18:13Z","message":"Set chunk loading radius to 0 in PlayerSpawnFinder\n\nhttps://github.com/Tuinity/Moonrise/pull/143\n\nFixes incorrect port from the Moonrise mixin causing a significant\nnumber of chunks to be loaded for spawn.\n"},{"sha":"13e9c107fe1ffc9061dab74a2e3417ff97253c4c","time":"2025-10-27T17:08:22Z","message":"[ci skip] Update mache for new unpick definitions\n"},{"sha":"9d427a5e574871e3a697ed5cb260ec1c36c90f0f","time":"2025-10-26T19:52:07Z","message":"[ci skip] Enable unpick (#13241)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-91.jar","checksums":{"sha256":"f6d8d80d25a687cc52a02a1d04cb25f167bb3a8a828271a263be2f44ada912cc"},"size":54465790,"url":"https://fill-data.papermc.io/v1/objects/f6d8d80d25a687cc52a02a1d04cb25f167bb3a8a828271a263be2f44ada912cc/paper-1.21.10-91.jar"}}},{"id":89,"time":"2025-10-26T18:49:51Z","channel":"BETA","commits":[{"sha":"c7714bbf3441c684bdcb4b93e829e272ced7201f","time":"2025-10-26T18:48:18Z","message":"Update PlayerPostRespawnEvent to include full location data (#13237)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-89.jar","checksums":{"sha256":"764ea594261bfe4902c775994f122ba26a1d25b9cc61705867637b751950cd56"},"size":53494788,"url":"https://fill-data.papermc.io/v1/objects/764ea594261bfe4902c775994f122ba26a1d25b9cc61705867637b751950cd56/paper-1.21.10-89.jar"}}},{"id":88,"time":"2025-10-25T23:58:45Z","channel":"BETA","commits":[{"sha":"2a1871bba6d4406c61c872a2977f62e3d8863efc","time":"2025-10-25T23:47:36Z","message":"Use static ThreadLocal for light engine propagator\n\nThe propagator has been changed so that its world may be updated.\nThis reduces extra memory by only requiring one propagator to be\ncached per thread, rather than one propagator per world per thread.\n\nThis change also avoids the dodgy behavior of ThreadLocal retaining\nreferences to values long after they would be collectable.\n\nFixes https://github.com/PaperMC/Paper/issues/13234\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-88.jar","checksums":{"sha256":"7434a3ab634ed79541c37b2ab1a37b0356b8949d6c83f8de4ec9e5794b3e7ad8"},"size":53492962,"url":"https://fill-data.papermc.io/v1/objects/7434a3ab634ed79541c37b2ab1a37b0356b8949d6c83f8de4ec9e5794b3e7ad8/paper-1.21.10-88.jar"}}},{"id":87,"time":"2025-10-25T19:06:05Z","channel":"BETA","commits":[{"sha":"b5b7c7910e98a4d74b1c5523fb1ee34ec9029695","time":"2025-10-25T19:04:35Z","message":"Promote build channel from ALPHA to BETA\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-87.jar","checksums":{"sha256":"c9dc93d44d0b0b414f7db9c746966c3991a33886c70fe04c403fd90381984088"},"size":53490628,"url":"https://fill-data.papermc.io/v1/objects/c9dc93d44d0b0b414f7db9c746966c3991a33886c70fe04c403fd90381984088/paper-1.21.10-87.jar"}}},{"id":86,"time":"2025-10-25T06:31:41Z","channel":"ALPHA","commits":[{"sha":"b278a92285f1ba2009d57deeb51b5bf95e982e7f","time":"2025-10-25T06:30:05Z","message":"Don't run player loot table for spectators (#11801)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-86.jar","checksums":{"sha256":"ed9685cc7c494d52d011be059a5d3018825fd623532ca35808eae4924f132e65"},"size":53488588,"url":"https://fill-data.papermc.io/v1/objects/ed9685cc7c494d52d011be059a5d3018825fd623532ca35808eae4924f132e65/paper-1.21.10-86.jar"}}},{"id":85,"time":"2025-10-23T17:10:21Z","channel":"ALPHA","commits":[{"sha":"d98142efca60d6e4a6b207082c912c6a894c1558","time":"2025-10-23T17:09:01Z","message":"Rework API teleportation to better align with Vanilla (#13181)\n\nCo-authored-by: Lulu13022002 <41980282+Lulu13022002@users.noreply.github.com>\n\n\nThis patch includes extensive changes to teleport logic in the API to better represent vanilla behavior. In particular, teleporting with passengers is now supported by default. This also allows for entities to be teleported across dimensions with passengers, except for players, which is still not supported. Entity state related teleportation flags have been deprecated, as that behavior occurs by default now. Additionally, relative teleportation flags are now supported on entities. \n﻿\nMost importantly, we no longer hack onto the respawn logic when teleporting players between dimensions in the API. This is a good step towards working on no longer reusing player entities on dimension swap, which is something we are trying to no longer do as it causes a large amount of desync issues on the client/server.\n﻿\nEntity teleportation via /tp now aligns with vanilla too, which now maintains velocity when teleporting.\n﻿\nThis is a breaking change."},{"sha":"080a72f208409a1286b07ae0c0e1ec5579e2591d","time":"2025-10-20T15:10:10Z","message":"[ci skip] Add myself (roro1506HD) to MIT licensing (#13212)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-85.jar","checksums":{"sha256":"1945d74304a244700985e5f64005da907e757b73ef3dba11079c737e641be330"},"size":53489740,"url":"https://fill-data.papermc.io/v1/objects/1945d74304a244700985e5f64005da907e757b73ef3dba11079c737e641be330/paper-1.21.10-85.jar"}}},{"id":84,"time":"2025-10-20T02:11:40Z","channel":"ALPHA","commits":[{"sha":"bac3da12dad74e224662745a13df7baf40c6448c","time":"2025-10-20T02:10:27Z","message":"Migrate external JD links from javadoc.io to javadocs.dev (#13205)\n\n"}],"downloads":{"server:default":{"name":"paper-1.21.10-84.jar","checksums":{"sha256":"461bf33493781600a2163b1ee84237b2cac5401d5e1c70801742a617e51df26c"},"size":53492959,"url":"https://fill-data.papermc.io/v1/objects/461bf33493781600a2163b1ee84237b2cac5401d5e1c70801742a617e51df26c/paper-1.21.10-84.jar"}}},{"id":83,